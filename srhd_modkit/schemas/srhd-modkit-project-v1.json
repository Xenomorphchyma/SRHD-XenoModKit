{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenomorphchyma.github.io/SRHD-XenoModKit/schema/srhd-modkit-project-v1.json",
  "title": "SRHD ModKit project configuration",
  "type": "object",
  "required": ["schema", "name", "mod_root"],
  "properties": {
    "schema": {"const": "srhd-modkit-project-v1"},
    "name": {"type": "string"},
    "mod_root": {"type": "string"},
    "prefix": {"type": "string"},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "external_builds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "project", "mode", "outputs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string"},
          "project": {"type": "string", "minLength": 1},
          "mode": {"enum": ["unconfigured", "prebuilt"]},
          "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": true
      }
    },
    "variants": {"type": "object"},
    "targets": {"type": "object"}
  },
  "additionalProperties": true
}
